# DeltaC Environment Configuration
PORT=5000

# Google Gemini API (Multimodal Environmental Vision)
# Obtain from https://aistudio.google.com/
# If omitted or invalid, DeltaC automatically runs in high-fidelity labeled Demo Mode
GEMINI_API_KEY=

# EVM Testnet Configuration (e.g. Polygon Amoy or Sepolia)
RPC_URL=https://rpc-amoy.polygon.technology
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=
